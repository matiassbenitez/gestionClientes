<script src="/js/monthly-chart.js" defer></script>
<h1 id="title" class="my-4 text-center text-primary"><%= title %></h1>
<div class="card border-danger mb-3 mx-auto" style="max-width: 400px;">
  <div class="card-body text-center">
    <div class="text-muted small text-uppercase">Total adeudado</div>
    <div id="totalOwed" class="fs-4 negative"><%= Number(totalOwed || 0).toLocaleString('es-AR', { style: 'currency', currency: 'ARS' }) %></div>
  </div>
</div>
<div class="chart-container" style="position: relative; height: 50vh; min-height: 400px;">
  <canvas id="barChart" data-chart-data='<%- JSON.stringify(chartData) %>'></canvas>
</div>
<div id="reportTableContainer">
</div>
<a href="/" class="btn btn-back">Volver al inicio</a>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>